# 账号密码请写入 credentials.local.env（见 credentials.local.env.example）

# 默认作业页面 URL（助教端「待批改」列表页；从浏览器地址栏复制 wlkcid 与 zyid）
THU_ASSIGNMENT_URL=https://learn.tsinghua.edu.cn/f/wlxt/kczy/xszy/teacher/beforePageList?wlkcid=YOUR_WLKCID&zyid=YOUR_ZYID

# 下载目录
THU_DOWNLOAD_DIR=./downloads

# 雨课堂智能批改（从 pro.yuketang.cn 批改页 URL 中获取 workspace 与 rule_id）
YUKETANG_WORKSPACE_ID=YOUR_WORKSPACE_ID
YUKETANG_RULE_ID=YOUR_REFLECTIVE_RULE_ID
YUKETANG_FORM_RULE_ID=YOUR_FORM_RULE_ID
